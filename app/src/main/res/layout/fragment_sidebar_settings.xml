<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Docked Sidebar Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Docked Sidebar Position"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Side tools placement when keyboard is docked at bottom."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgDockedSidebar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDockedRight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Right Side (Default)" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDockedLeft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Left Side" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Floating Sidebar Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Floating Sidebar Position"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Side tools placement when keyboard is in floating window mode."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgFloatingSidebar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbFloatingRight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Right Side (Default)" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbFloatingLeft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Left Side" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Delete Button Position Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete Button Position"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:text="Choose whether backspace moves with side tools or stays fixed."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgDeleteButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDeleteFollow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Follow Side Tools (Default)" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDeleteFixedRight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Always Fixed Right" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDeleteFixedLeft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Always Fixed Left" />
                </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
