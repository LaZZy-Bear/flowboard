<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/textEditPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/prediction_key_bg"
    android:padding="6dp"
    android:visibility="gone">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:drawableStart="@drawable/ic_text_edit"
        android:drawablePadding="6dp"
        app:drawableTint="@color/text_tap"
        android:text="@string/text_editing"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_tap" />

    <!-- Main Controller Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center"
        android:layout_marginTop="2dp"
        tools:ignore="NestedWeights">

        <!-- Left Tools: Select, Select All, Copy, Cut, Paste -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Row 1: Select & Select All -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/btnTextSelect"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/select"
                    android:textSize="11sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/fn_key_bg"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:id="@+id/btnTextSelectAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/select_all"
                    android:textSize="11sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/fn_key_bg"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- Row 2: Cut & Copy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/btnTextCut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/cut"
                    android:textSize="11sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/fn_key_bg"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:id="@+id/btnTextCopy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/copy"
                    android:textSize="11sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/fn_key_bg"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- Row 3: Paste & Delete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/btnTextPaste"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/paste"
                    android:textSize="11sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/fn_key_bg"
                    android:layout_marginEnd="2dp" />

                <TextView
                    android:id="@+id/btnTextDelete"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/delete"
                    android:textSize="11sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/fn_key_bg"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/text_icon"
            android:alpha="0.2"
            android:layout_marginHorizontal="6dp" />

        <!-- Right: D-Pad Navigation & Jump -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Top Row: Jump Start | Up Arrow | Jump End -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/btnTextJumpStart"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_jump_start"
                    android:padding="6dp"
                    android:background="@drawable/fn_key_bg"
                    app:tint="@color/text_tap"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/jump_to_start" />

                <ImageView
                    android:id="@+id/btnTextArrowUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_arrow_up"
                    android:padding="6dp"
                    android:background="@drawable/key_bg"
                    app:tint="@color/text_tap"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="@string/arrow_up" />

                <ImageView
                    android:id="@+id/btnTextJumpEnd"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_jump_end"
                    android:padding="6dp"
                    android:background="@drawable/fn_key_bg"
                    app:tint="@color/text_tap"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/jump_to_end" />
            </LinearLayout>

            <!-- Middle Row: Left Arrow | Center/Home | Right Arrow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/btnTextArrowLeft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_arrow_left"
                    android:padding="6dp"
                    android:background="@drawable/key_bg"
                    app:tint="@color/text_tap"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/arrow_left" />

                <TextView
                    android:id="@+id/btnTextCenter"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/dpad_center"
                    android:textSize="16sp"
                    android:textColor="@color/text_icon"
                    android:background="@drawable/prediction_key_bg"
                    android:layout_marginHorizontal="2dp" />

                <ImageView
                    android:id="@+id/btnTextArrowRight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_arrow_right"
                    android:padding="6dp"
                    android:background="@drawable/key_bg"
                    app:tint="@color/text_tap"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@string/arrow_right" />
            </LinearLayout>

            <!-- Bottom Row: Down Arrow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="2dp" />

                <ImageView
                    android:id="@+id/btnTextArrowDown"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_arrow_down"
                    android:padding="6dp"
                    android:background="@drawable/key_bg"
                    app:tint="@color/text_tap"
                    android:layout_marginHorizontal="2dp"
                    android:contentDescription="@string/arrow_down" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
