<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickThemePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/prediction_key_bg"
    android:padding="8dp"
    android:visibility="gone">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        app:drawableStartCompat="@drawable/ic_theme"
        android:drawablePadding="6dp"
        app:drawableTint="@color/text_tap"
        android:text="@string/quick_theme"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_tap" />

    <!-- Dark/Light Mode Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode"
            android:textSize="12sp"
            android:textColor="@color/text_tap"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:background="@drawable/fn_key_bg"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnThemeLight"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/theme_light"
                android:textSize="11sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/key_bg" />

            <TextView
                android:id="@+id/btnThemeDark"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/theme_dark"
                android:textSize="11sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/fn_key_bg" />

            <TextView
                android:id="@+id/btnThemeSystem"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/theme_auto"
                android:textSize="11sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/fn_key_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- Color Palettes (Ocean Blue, Mint Teal, Sunset Coral) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <FrameLayout
            android:id="@+id/paletteOcean"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="10dp"
            android:background="#0984E3" />

        <FrameLayout
            android:id="@+id/paletteTeal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="10dp"
            android:background="#00B894" />

        <FrameLayout
            android:id="@+id/paletteCoral"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="10dp"
            android:background="#E17055" />
    </LinearLayout>

    <!-- Open Full Theme Settings -->
    <TextView
        android:id="@+id/btnOpenFullThemes"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="@string/more_themes"
        android:textSize="12sp"
        android:textColor="@color/text_tap"
        android:background="@drawable/fn_key_bg" />
</LinearLayout>
