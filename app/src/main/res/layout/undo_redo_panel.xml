<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/undoRedoPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/prediction_key_bg"
    android:padding="8dp"
    android:visibility="gone">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        app:drawableStartCompat="@drawable/ic_undo"
        android:drawablePadding="6dp"
        app:drawableTint="@color/text_tap"
        android:text="@string/undo_and_history"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_tap" />

    <!-- 3 Action Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center"
        android:layout_marginTop="8dp"
        tools:ignore="NestedWeights">

        <!-- Undo Card -->
        <TextView
            android:id="@+id/cardUndo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fn_key_bg"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            app:drawableTopCompat="@drawable/ic_undo"
            android:drawablePadding="4dp"
            app:drawableTint="@color/text_tap"
            android:text="@string/undo"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_tap" />

        <!-- Redo Card -->
        <TextView
            android:id="@+id/cardRedo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fn_key_bg"
            android:layout_marginHorizontal="2dp"
            android:padding="8dp"
            app:drawableTopCompat="@drawable/ic_redo"
            android:drawablePadding="4dp"
            app:drawableTint="@color/text_tap"
            android:text="@string/redo"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_tap" />

        <!-- Clear All Card -->
        <TextView
            android:id="@+id/cardClearAll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/fn_key_bg"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            app:drawableTopCompat="@drawable/ic_clear_all"
            android:drawablePadding="4dp"
            app:drawableTint="@color/text_tap"
            android:text="@string/clear_all"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_tap" />
    </LinearLayout>
</LinearLayout>
