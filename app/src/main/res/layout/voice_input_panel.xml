<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/voiceInputPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/prediction_key_bg"
    android:padding="8dp"
    android:visibility="gone">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        app:drawableStartCompat="@drawable/ic_mic"
        android:drawablePadding="6dp"
        app:drawableTint="@color/text_tap"
        android:text="@string/voice_typing"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_tap" />

    <!-- Live Speech Text Display -->
    <TextView
        android:id="@+id/voiceLiveText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/speak_now"
        android:textSize="15sp"
        android:textColor="@color/text_tap"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Mic Button & Status Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="4dp">

        <FrameLayout
            android:id="@+id/btnVoiceMic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/fn_key_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivVoiceMicIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_tap"
                android:contentDescription="@string/microphone" />
        </FrameLayout>

        <TextView
            android:id="@+id/voiceStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tap_to_start_stop"
            android:textSize="11sp"
            android:textColor="@color/text_swipe" />
    </LinearLayout>
</LinearLayout>
