<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/emojiPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:visibility="gone"
    tools:ignore="HardcodedText">

    <!-- Category Tabs Bar (Top) -->
    <HorizontalScrollView
        android:id="@+id/emojiCategoryScroll"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fadingEdge="none"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Category Tabs -->
            <TextView
                android:id="@+id/btnEmojiCatRecent"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="🕒"
                android:textSize="18sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnEmojiCatSmileys"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="😊"
                android:textSize="18sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnEmojiCatPeople"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="👋"
                android:textSize="18sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnEmojiCatAnimals"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="🐶"
                android:textSize="18sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnEmojiCatFood"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="🍔"
                android:textSize="18sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnEmojiCatTravel"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="✈️"
                android:textSize="18sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnEmojiCatActivities"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="⚽"
                android:textSize="18sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnEmojiCatObjects"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="💡"
                android:textSize="18sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnEmojiCatFlags"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="🚩"
                android:textSize="18sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Subtle Divider -->
    <View
        android:id="@+id/emojiCategoryDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <!-- Emoji Grid Area -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emojiRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none" />
</LinearLayout>
