<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="HardcodedText,NestedWeights,SmallSp,UnusedAttribute,UselessParent">

    <FrameLayout
        android:id="@+id/keyboardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kb_background"
        android:paddingHorizontal="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/keyboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


        <!-- Number Row (initially GONE, managed by preferences) -->
        <LinearLayout
            android:id="@+id/numberRow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            android:paddingHorizontal="2dp">
            
            <TextView
                android:id="@+id/num1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="2"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="3"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="4"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="5"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="6"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="7"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="8"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="9"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg"
                android:layout_marginEnd="3dp" />
            <TextView
                android:id="@+id/num0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0"
                android:textSize="16sp"
                android:textColor="@color/text_tap"
                android:background="@drawable/prediction_key_bg" />
        </LinearLayout>

        <!-- ═══ Prediction Row (Contains Predictions + Delete Button) ═══ -->
        <LinearLayout
            android:id="@+id/predictionRow"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:layout_marginBottom="4dp"
            android:paddingHorizontal="2dp">

            <LinearLayout
                android:id="@+id/predictionBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/pred1"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/prediction_key_bg"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/pred2"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/prediction_key_bg"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/pred3"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="@color/text_tap"
                    android:background="@drawable/prediction_key_bg"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_backspace"
                android:background="@drawable/tool_key_bg"
                android:scaleType="center"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:contentDescription="Delete" />
        </LinearLayout>

        <!-- ═══ Main Area: Grid + Side Tools ═══ -->
        <LinearLayout
            android:id="@+id/mainArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 3x3 Key Grid -->
            <com.flowboard.ime.ui.KeyboardView
                android:id="@+id/keyboardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- More Panel Container (initially GONE) -->
            <GridLayout
                android:id="@+id/morePanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:columnCount="3"
                android:rowCount="2"
                android:padding="8dp"
                android:visibility="gone">
                <!-- Dynamically populated in code -->
            </GridLayout>

            <!-- Clipboard Panel Container (initially GONE) -->
            <ScrollView
                android:id="@+id/clipboardPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="8dp"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/clipboardContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    
                    >
                    <!-- Dynamically populated clipboard items -->
                </LinearLayout>
            </ScrollView>

            <!-- Side Tools Panel (Control Panel) -->
            <LinearLayout
                android:id="@+id/sideTools"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/side_tools_bg"
                android:layout_marginStart="6dp"
                android:paddingVertical="8dp">
                <!-- Dynamically populated in code -->
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Bottom Bar ═══ -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/btnNumbers"
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/numbers_label"
                android:textSize="13sp"
                android:textColor="@color/text_icon"
                android:background="@drawable/fn_key_bg"
                android:layout_marginEnd="4dp"
                android:fontFamily="sans-serif-medium" />

            <FrameLayout
                android:id="@+id/btnShift"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="match_parent"
                android:background="@drawable/fn_key_bg"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:id="@+id/btnShiftIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_shift"
                    android:scaleType="center"
                    android:padding="10dp"
                    android:contentDescription="Shift" />

                <TextView
                    android:id="@+id/btnShiftText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="@color/text_icon"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnGlobe"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="match_parent"
                android:src="@drawable/ic_globe"
                android:background="@drawable/fn_key_bg"
                android:scaleType="center"
                android:padding="10dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Language" />

            <FrameLayout
                android:id="@+id/btnSpace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3.3"
                android:background="@drawable/fn_key_bg"
                android:layout_marginEnd="4dp">
                
                <TextView
                    android:id="@+id/btnSpaceText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/space_label"
                    android:textSize="14sp"
                    android:textColor="@color/text_swipe"
                    android:fontFamily="sans-serif-medium" />
                    
                <TextView
                    android:id="@+id/btnSpaceDownText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center_horizontal"
                    android:text="0"
                    android:textSize="12sp"
                    android:textColor="@color/text_swipe"
                    android:alpha="0.5"
                    android:paddingBottom="2dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnPeriod"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="match_parent"
                android:background="@drawable/fn_key_bg"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/btnPeriodText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="."
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_tap"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/btnPeriodCommaText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:text=","
                    android:textSize="10sp"
                    android:textColor="@color/text_swipe"
                    android:paddingTop="2dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSend"
                android:layout_width="0dp"
                android:layout_weight="1.6"
                android:layout_height="match_parent"
                android:background="@drawable/send_btn_bg"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/btnSendIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    android:contentDescription="Send" />
            </FrameLayout>
        </LinearLayout>

        <!-- Dedicated Floating Control Bar (visible only in Floating Mode) -->
        <LinearLayout
            android:id="@+id/floatingControlBar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <!-- Drag Handle Bar (Center Area) -->
            <FrameLayout
                android:id="@+id/dragHandleArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">
                <View
                    android:layout_width="60dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center"
                    android:background="@drawable/prediction_key_bg"
                    android:backgroundTint="#99888888" />
            </FrameLayout>

            <!-- Resize Handle Right (Bottom-Right) -->
            <ImageView
                android:id="@+id/resizeHandleRight"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_resize_modern"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:backgroundTint="#80888888"
                android:contentDescription="Resize Window Right" />
        </LinearLayout>

        </LinearLayout>
            
    </FrameLayout>

    <!-- Height Adjustment Overlay (initially GONE) -->
    <LinearLayout
        android:id="@+id/heightAdjustLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#F0F0F0"
        android:padding="8dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ขนาด:"
            android:textColor="@android:color/black"
            android:layout_marginEnd="8dp" />
            
        <Button
            android:id="@+id/btnSizeSmall"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#CCCCCC"
            android:textColor="@android:color/black"
            android:text="เล็ก" />
            
        <Button
            android:id="@+id/btnSizeMedium"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#CCCCCC"
            android:textColor="@android:color/black"
            android:text="กลาง" />
            
        <Button
            android:id="@+id/btnSizeLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:textSize="12sp"
            android:backgroundTint="#CCCCCC"
            android:textColor="@android:color/black"
            android:text="ใหญ่" />

        <ImageView
            android:id="@+id/btnCloseHeightAdjust"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:padding="4dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Close" />
    </LinearLayout>

</FrameLayout>
